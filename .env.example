# .env.example — Copy this to .env and adjust the path.
#
#   cp .env.example .env   (Windows: copy)
#
# The ONLY variable this server reads is GOOGLE_ADS_CONFIGURATION_FILE_PATH.
# All Google Ads credentials live in google-ads.yaml, NOT here.
#
# Point this at your google-ads.yaml. Required if the yaml is in the project
# folder (the client library does not search the project folder by default).
# Leave it unset if your yaml is at ~/google-ads.yaml or ~/.config/google-ads.yaml.

GOOGLE_ADS_CONFIGURATION_FILE_PATH=E:\Sample Projects\google-ads-mcp\google-ads.yaml
